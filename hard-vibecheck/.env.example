# Copy to .env (git-ignored) or export these in your shell before running main.py.
# Placeholders only. Never commit a real key.

VIBECHECK_PROVIDER=openai          # openai | openai_compatible | anthropic | gemini
VIBECHECK_API_KEY=replace-me
VIBECHECK_MODEL=gpt-4o-mini        # optional override
VIBECHECK_BASE_URL=                # optional, e.g. a compatible gateway
VIBECHECK_TIMEOUT=30               # seconds per request
VIBECHECK_RETRIES=2                # retries for HTTP 429 and 5xx only
